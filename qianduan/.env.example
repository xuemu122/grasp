# Copy to .env for local simulation only, or export these variables from the shell.
# Production deployments should use /etc/grasp-qianduan.env instead.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=replace-with-a-random-secret-at-least-32-bytes
ORDER_TOKEN_SECRET=replace-with-a-separate-random-secret
ROBOT_GRASP_MODE=sim
PORT=3000
WS_PORT=3001
