# Copy to .env for local simulation only, or export these variables from the shell.
# Production deployments should use /etc/grasp-qianduan.env instead.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-random-password-at-least-16-chars
ADMIN_SESSION_SECRET=replace-with-a-random-secret-at-least-32-bytes
ORDER_TOKEN_SECRET=replace-with-a-separate-random-secret-at-least-32-bytes
ORDERS_DB_FILE=./data/orders.json
PAYMENT_MODE=free
# Formal deployment: PAYMENT_MODE=lyorder
PAYMENT_API_BASE_URL=http://127.0.0.1:8080
PAYMENT_API_TOKEN=
PAYMENT_DEVICE_SN=GRASP-ROBOT-01
PAYMENT_REQUEST_TIMEOUT_MS=15000
PAYMENT_STATUS_SWEEP_INTERVAL_MS=10000
PAYMENT_STATUS_QUERY_INTERVAL_MS=5000
ORDER_PAID_START_TIMEOUT_MS=1800000
ORDER_STATUS_CALLBACK_URL=
ORDER_STATUS_CALLBACK_SECRET=replace-with-a-shared-random-secret
ORDER_CALLBACK_OUTBOX_FILE=./data/order_callback_outbox.json
ORDER_CALLBACK_RETRY_INTERVAL_MS=15000
ORDER_CALLBACK_TLS_INSECURE=0
PAYMENT_TLS_INSECURE=0
ORDER_EXECUTION_REFUND_TIMEOUT_MS=1800000
ORDER_REFUND_SWEEP_INTERVAL_MS=60000
# Keep false on the formal service. The test service may set this to true.
ALLOW_FREE_ORDERS=0
ROBOT_GRASP_MODE=sim
PORT=3000
WS_PORT=3001
CHASSIS_HOST=192.168.10.10
CHASSIS_PORT=31001
CHASSIS_MAP_HTTP_HOST=192.168.10.10
CHASSIS_MAP_HTTP_PORT=9001
CHASSIS_PLACE_MARKER=fangzhi
CHASSIS_CHARGE_MARKER=charge_point_1F_35744
